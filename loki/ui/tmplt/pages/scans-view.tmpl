<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="row align-items-center mb-4">
        <div class="col">
          <h2 class="h3 page-title">Scanning Operations</h2>
          <p class="text-muted lead">Manage, monitor, and audit live orchestration runs across your targeted infrastructure footprint.</p>
        </div>
        <div class="col-auto">
          <button type="button" class="btn btn-primary btn-lg" data-toggle="modal" data-target="#createScanModal">
            <span class="fe fe-plus fe-16 mr-2"></span>Launch Operational Run
          </button>
        </div>
      </div>

      <div class="row section my-4">
        <div class="col-md-4">
          <div class="card shadow mb-4">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-3 text-center">
                  <span class="circle circle-md bg-primary">
                    <span class="fe fe-activity fe-24 text-white"></span>
                  </span>
                </div>
                <div class="col">
                  <h3 class="h6 mb-0 text-uppercase">Active Engagements</h3>
                  <p class="small text-muted mb-0">Currently executing profiling loops</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card shadow mb-4">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-3 text-center">
                  <span class="circle circle-md bg-warning">
                    <span class="fe fe-shield fe-24 text-white"></span>
                  </span>
                </div>
                <div class="col">
                  <h3 class="h6 mb-0 text-uppercase">Active Filter Casing</h3>
                  <p class="small text-muted mb-0">Current configuration: <strong class="text-info">{{.ScanType}}</strong></p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card shadow mb-4">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-3 text-center">
                  <span class="circle circle-md bg-success">
                    <span class="fe fe-layers fe-24 text-white"></span>
                  </span>
                </div>
                <div class="col">
                  <h3 class="h6 mb-0 text-uppercase">Completed Batches</h3>
                  <p class="small text-muted mb-0">Total jobs persisted on cluster</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card shadow mb-4">
        <div class="card-body">
          <div class="toolbar row mb-3">
            <div class="col"><h5 class="card-title">Orchestration Index</h5></div>
            <div class="col text-right">
              <div class="btn-group" role="group">
                <a href="/scans/render?scantype=ALL" class="btn btn-sm btn-outline-secondary">All</a>
                <a href="/scans/render?scantype=Pentest" class="btn btn-sm btn-outline-secondary">Pentests</a>
                <a href="/scans/render?scantype=Bug Bounty" class="btn btn-sm btn-outline-secondary">Bug Bounty</a>
                <a href="/scans/render?scantype=Black Ops" class="btn btn-sm btn-outline-secondary">Black Ops</a>
              </div>
            </div>
          </div>

          <table class="table datatables table-hover table-borderless border-v" id="dataTable-1">
            <thead class="thead-dark">
              <tr>
                <th>Scan Identifier</th>
                <th>Operation Label</th>
                <th>Classification Profile</th>
                <th>Owning Identity</th>
                <th>Temporal Stamp</th>
                <th>Operational Integrity</th>
              </tr>
            </thead>
            <tbody>
              {{range .Scans}}
              <tr>
                <td><code>{{.ScanID}}</code></td>
                <td><strong>{{.Name}}</strong></td>
                <td>
                  <span class="badge badge-pill {{if eq .ScanType `Black Ops`}}badge-danger{{else if eq .ScanType `Pentest`}}badge-warning{{else}}badge-success{{end}} text-white">
                    {{.ScanType}}
                  </span>
                </td>
                <td class="text-muted"><span class="fe fe-user mr-2"></span>{{.OwnerID}}</td>
                <td><small class="text-muted">{{.CreatedAt.Format "Jan 02, 2006 15:04"}}</small></td>
                <td>
                  <a href="/scans/list-targets?scanid={{.ScanID}}" class="btn btn-sm btn-outline-primary">
                    <span class="fe fe-crosshair mr-2"></span>Analyze Targets
                  </a>
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="6" class="text-center py-5 bg-light text-muted">
                  <span class="fe fe-alert-circle fe-24 mb-2 d-block"></span>
                  No scan operations found for classification type filter.
                </td>
              </tr>
              {{end}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>