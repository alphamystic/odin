
<div id="ms-alert-stack" style="position: fixed; top: 20px; right: 20px; z-index: 1100; width: 350px;"></div>

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <h2 class="h3 mb-0">Mothership Fleet</h2>
        <button class="btn btn-primary ml-auto" data-toggle="modal" data-target="#msModal" onclick="prepModal('create')">
            <span class="fe fe-plus mr-2"></span>Deploy Node
        </button>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Identification</th>
                <th>Network & Tunnels</th>
                <th>Machine Info</th>
                <th>Status</th>
                <th class="text-right">Action</th>
            </tr>
        </thead>
        <tbody>
            {{range .motherships}}
            <tr>
                <td>
                    <strong>{{.Name}}</strong><br>
                    <small class="text-muted">{{.MSId}}</small>
                </td>
                <td>
                    <code>{{.Address}}</code><br>
                    <small class="text-info">Imp: {{.ImplantTunnel}}</small>
                </td>
                <td id="machine-cell-{{.MSId}}">
                    <script>
                        (function() {
                            const raw = '{{.Machinedata}}'; //
                            const id = '{{.MSId}}';
                            const target = document.getElementById(`machine-cell-${id}`);
                            if (raw && raw !== "" && raw !== "{}") {
                                try {
                                    const data = JSON.parse(raw);
                                    let badges = '';
                                    for (const [key, value] of Object.entries(data)) {
                                        badges += `<span class="badge badge-light border mr-1 text-uppercase">${key}: ${value}</span>`;
                                    }
                                    target.innerHTML = badges;
                                } catch (e) {
                                    target.innerText = raw;
                                }
                            }
                        })();
                    </script>
                </td>
                <td>
                    <span class="dot dot-lg {{if .IsOnline}}bg-success{{else}}bg-secondary{{end}} mr-2"></span>
                    {{if .Active}}<span class="badge badge-dark">Active</span>{{else}}<span class="badge badge-warning">Paused</span>{{end}}
                </td>
                <td class="text-right">
                    <button class="btn btn-sm btn-outline-primary" 
                        onclick="prepEdit(this)"
                        data-msid="{{.MSId}}"
                        data-name="{{.Name}}"
                        data-owner="{{.OwnerID}}"
                        data-addr="{{.Address}}"
                        data-iaddr="{{.IAddress}}"
                        data-oaddr="{{.OAddress}}"
                        data-imp="{{.ImplantTunnel}}"
                        data-adm="{{.AdminTunnel}}"
                        data-gen="{{.GenCommand}}"
                        data-machine='{{.Machinedata}}'
                        data-desc="{{.Description}}"
                        data-tls="{{.Tls}}"
                        data-active="{{.Active}}"> 
                        <i class="fe fe-edit"></i>
                    </button>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="5" class="text-center text-muted">No motherships found in the intelligence database.</td>
            </tr>
            {{end}}
        </tbody>
    </table>
</div>

<div class="modal fade" id="msModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="msModalLabel">Mothership Intelligence Core</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form id="msForm">
                <div class="modal-body">
                    <input type="hidden" id="f_msid">
                    <input type="hidden" id="f_ownerid">

                    <div class="row">
                        <div class="col-md-7 border-right">
                            <h6 class="text-uppercase small font-weight-bold mb-3 text-primary">Identity & Networking</h6>
                            <div class="row">
                                <div class="col-6 form-group">
                                    <label class="small font-weight-bold">Name</label>
                                    <input type="text" id="f_name" class="form-control" placeholder="Megladon MS">
                                </div>
                                <div class="col-6 form-group">
                                    <label class="small font-weight-bold">Primary IP (Address)</label>
                                    <input type="text" id="f_addr" class="form-control" placeholder="9.9.9.9">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6 form-group">
                                    <label class="small font-weight-bold">Internal Address (iAddress)</label>
                                    <input type="text" id="f_iaddr" class="form-control">
                                </div>
                                <div class="col-6 form-group">
                                    <label class="small font-weight-bold">Overlay Address (oAddress)</label>
                                    <input type="text" id="f_oaddr" class="form-control">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="small font-weight-bold">Implant Tunnel</label>
                                <input type="text" id="f_imp" class="form-control" placeholder="https://...">
                            </div>
                            <div class="form-group">
                                <label class="small font-weight-bold">Admin Tunnel</label>
                                <input type="text" id="f_adm" class="form-control" placeholder="https://...">
                            </div>
                        </div>

                        <div class="col-md-5">
                            <h6 class="text-uppercase small font-weight-bold mb-3 text-primary">Deployment & Metadata</h6>
                            <div class="form-group">
                                <label class="small font-weight-bold">Generate Command</label>
                                <input type="text" id="f_gen" class="form-control" placeholder="go build .">
                            </div>
                            <div class="form-group">
                                <label class="small font-weight-bold">Machine Data (JSON)</label>
                                <div style="height: 120px; border: 1px solid #ced4da; border-radius: 4px; padding: 5px; background: #f8f9fa;">
                                    <textarea id="f_machine" class="form-control border-0 bg-transparent p-1" style="height: 100%; font-family: monospace; font-size: 12px;"
                                        placeholder='{"os":"linux"}'></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="small font-weight-bold">Description</label>
                                <textarea id="f_desc" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="row mt-3">
                                <div class="col-6">
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input" id="f_tls">
                                        <label class="custom-control-label small" for="f_tls">TLS Active</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input" id="f_active" checked>
                                        <label class="custom-control-label small" for="f_active">Status Active</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success px-5" onclick="executeSync()">Deploy Mothership</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const API_URL = "/api/mothership"; // Local route to your UI handler or direct API

function spawnAlert(type, msg) {
    const icon = type === 'success' ? 'fe-help-circle' : 'fe-minus-circle';
    const alertBody = `
        <div class="alert alert-${type} shadow border-0 fade show" role="alert">
            <span class="fe ${icon} fe-16 mr-2"></span> ${msg}
        </div>`;
    $('#ms-alert-stack').html(alertBody);
    setTimeout(() => { $('#ms-alert-stack').empty(); }, 4000);
}

function prepModal(mode) {
    $('#msModalLabel').text(mode === 'create' ? "Deploy New Mothership" : "Edit Configuration");
    $('#f_msid').val("");
    document.getElementById('msForm').reset();
    if(mode === 'create') {
        $('#f_machine').val('{"os": "linux", "arch": "amd64"}'); // Sample input for machine data
    }
}

function prepEdit(btn) {
    const d = $(btn).data();
    
    $('#f_msid').val(d.msid);
    $('#f_ownerid').val(d.owner);
    $('#f_name').val(d.name);
    $('#f_addr').val(d.addr);
    $('#f_iaddr').val(d.iaddr);
    $('#f_oaddr').val(d.oaddr);
    $('#f_imp').val(d.imp);
    $('#f_adm').val(d.adm);
    $('#f_gen').val(d.gen);
    $('#f_desc').val(d.desc);
    
    // Parse strings/booleans from data attributes
    $('#f_tls').prop('checked', String(d.tls) === "true");
    $('#f_active').prop('checked', String(d.active) === "true");
    $('#f_machine').val(d.machine); //

    $('#msModalLabel').text("Modify Mothership Intelligence");
    $('#msModal').modal('show');
}

function executeSync() {
    const id = $('#f_msid').val();
    const machineDataRaw = $('#f_machine').val();

    // Validate JSON before submission
    try {
        if (machineDataRaw !== "") JSON.parse(machineDataRaw); //
    } catch (e) {
        spawnAlert('danger', 'JSON Error in Machine Data field.');
        return;
    }

    const payload = {
        mothershipid: id,
        ownerid: $('#f_ownerid').val(),
        name: $('#f_name').val(),
        address: $('#f_addr').val(),
        iaddress: $('#f_iaddr').val(),
        oaddress: $('#f_oaddr').val(),
        implant_tunnel: $('#f_imp').val(),
        admin_tunnel: $('#f_adm').val(),
        generate_command: $('#f_gen').val(),
        machine_data: machineDataRaw, // Transmitted as a string to be handled as escaped JSON
        description: $('#f_desc').val(),
        tls: $('#f_tls').is(':checked'),
        active: $('#f_active').is(':checked')
    };

    $.ajax({
        url: API_URL + (id ? "/update" : "/create"), //
        method: "POST",
        contentType: "application/json",
        xhrFields: { withCredentials: true },
        data: JSON.stringify(payload),
        success: function() {
            spawnAlert('success', 'Mothership intelligence synchronized.');
            setTimeout(() => { location.reload(); }, 1200);
        },
        error: function(xhr) {
            const err = xhr.responseJSON ? (xhr.responseJSON.error || xhr.responseJSON.message) : "Network failure";
            spawnAlert('danger', err);
        }
    });
}
</script>
