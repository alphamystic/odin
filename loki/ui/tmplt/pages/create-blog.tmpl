<!-- Editor Section -->
<div class="row mb-4">
  <div class="col-md-12">
    <div class="card shadow">
      <div class="card-body">
        <h5 class="card-title">Editor</h5>
        <p>Pages type scale includes a range of contrasting styles that support the needs of your product and its content.</p>
        <!-- Create the editor container -->
        <div id="editor">
        drgdhfhfhf</div>
        <button type="button" class="btn mb-2 btn-outline-success" onclick="submitBlog()">Submit</button>
      </div>
    </div>
  </div>
</div> <!-- end section -->

<!-- Quill JS -->
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script>
  // Initialize Quill Editor
  var editor = document.getElementById('editor');
  var quill = new Quill(editor, {
    theme: 'snow',
    modules: {
      toolbar: [
        [{ 'font': [] }, { 'header': [1, 2, 3, 4, 5, 6, false] }],
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block'],
        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
        [{ 'script': 'sub' }, { 'script': 'super' }],
        [{ 'indent': '-1' }, { 'indent': '+1' }],
        [{ 'direction': 'rtl' }],
        [{ 'color': [] }, { 'background': [] }],
        [{ 'align': [] }],
        ['clean']
      ]
    }
  });
  // Function to Submit Blog Content
  function submitBlog() {
    var content = quill.root.innerHTML; // Get the content as HTML
    var jsonData = JSON.stringify({ content: content });

    fetch("http://localhost:5000/writeblog", {
      method: "POST",
      headers: {
          "Content-Type": "application/json"
      },
      body: jsonData
    })
    .then(response => response.json())
    .then(data => {
      alert("Blog submitted successfully!");
      console.log(data);
    })
    .catch(error => console.error("Error:", error));
  }
</script>



<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

<style>
    /* Force visibility on the editor container */
    #editor-wrapper {
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: 4px;
    }
    #main-editor {
        height: 500px !important;
        overflow-y: auto;
        font-family: 'Overpass', sans-serif;
        font-size: 1rem;
    }
    .ql-toolbar.ql-snow {
        border-top: none !important;
        border-left: none !important;
        border-right: none !important;
        background-color: #f8f9fa;
    }
    /* Fix for hidden file input */
    #importFile { opacity: 0; position: absolute; z-index: -1; }
</style>

<div id="ms-alert-stack" style="position: fixed; top: 20px; right: 20px; z-index: 3000; width: 350px;"></div>

<div class="container-fluid">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="h3 mb-0 page-title">Intelligence Report Architect</h2>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" data-toggle="modal" data-target="#importModal">Import Document</button>
            <button class="btn btn-outline-primary" data-toggle="modal" data-target="#newEnumModal">Add Enum</button>
            <button class="btn btn-outline-primary" data-toggle="modal" data-target="#newCatModal">Add Category</button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-body">


                    <label class="h5">Technical Narrative</label>
                    <div id="editor-wrapper">
                        <div id="main-editor">
                            <p>Start typing your intelligence report here...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header">
                    <strong class="card-title">Classifications</strong>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label>Main Classification</label>
                        <select id="maintag" class="form-control select2">
                            {{range .parent_categories}}<option value="{{.Type}}">{{.Type}}</option>{{end}}
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label>Primary Categories</label>
                        <select id="categories" class="form-control select2-multi" multiple="multiple">
                            {{range .categories}}{{if not .ParentID}}<option value="{{.ID}}">{{.Name}}</option>{{end}}{{end}}
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label>Sub-Categories</label>
                        <select id="subcats" class="form-control select2-multi" multiple="multiple">
                            {{range .categories}}{{if .ParentID}}<option value="{{.ID}}">{{.Name}} (P:{{.ParentID}})</option>{{end}}{{end}}
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label>Tags</label>
                        <input type="text" id="tags" class="form-control" placeholder="rce, linux, malware">
                    </div>

                    <hr>

                    <button type="button" onclick="submitBlog()" class="btn btn-success btn-block btn-lg shadow mt-3">
                        <i class="fe fe-save mr-2"></i> Deploy Intelligence
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white"><h5>Import Document</h5></div>
            <div class="modal-body text-center py-4">
                <label for="importFile" class="btn btn-outline-success btn-lg mb-3" style="cursor:pointer;">
                    <i class="fe fe-upload-cloud mr-2"></i> Choose File
                </label>
                <input type="file" id="importFile" accept=".pdf,.docx" onchange="updateFileName(this)">
                <div id="file-name-display" class="small text-muted mb-3"></div>
                <button type="button" class="btn btn-primary btn-block" onclick="doUploadProcess()">Process & Import</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="newEnumModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header bg-dark text-white"><h5>New Enum</h5></div><div class="modal-body"><input type="text" id="enumName" class="form-control mb-2" placeholder="Name"><textarea id="enumDesc" class="form-control" placeholder="Description"></textarea></div><div class="modal-footer"><button class="btn btn-success" onclick="createMetadata('/api/report/enum/create', {name: $('#enumName').val(), description: $('#enumDesc').val()})">Save</button></div></div></div></div>
<div class="modal fade" id="newCatModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header bg-dark text-white"><h5>New Category</h5></div><div class="modal-body"><input type="text" id="catName" class="form-control mb-2" placeholder="Name"><select id="catParent" class="form-control"><option value="0">None</option>{{range .parent_categories}}<option value="{{.ID}}">{{.Type}}</option>{{end}}</select></div><div class="modal-footer"><button class="btn btn-success" onclick="createMetadata('/api/report/category/create', {name: $('#catName').val(), parent_id: parseInt($('#catParent').val()) || null})">Save</button></div></div></div></div>

<script>
let quillObj;

function updateFileName(input) {
    const fileName = input.files[0] ? input.files[0].name : "";
    document.getElementById('file-name-display').innerText = fileName;
}

$(document).ready(function() {
    // Initialize Quill with a slight delay to ensure the container is rendered
    setTimeout(function() {
        quillObj = new Quill('#main-editor', {
            theme: 'snow',
            placeholder: 'Technical findings go here...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'code-block'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });
    }, 300);

    // Initialize Select2
    if($.fn.select2) {
        $('.select2').select2({ theme: 'bootstrap4' });
        $('.select2-multi').select2({ theme: 'bootstrap4', multiple: true });
    }
});

function doUploadProcess() {
    const file = document.getElementById('importFile').files[0];
    if (!file) { spawnAlert('danger', 'Select a file first'); return; }

    const fd = new FormData();
    fd.append('file', file);

    $.ajax({
        url: '/reports/import',
        method: 'POST',
        data: fd,
        processData: false,
        contentType: false,
        success: function(res) {
            if(res.html) {
                quillObj.root.innerHTML = res.html;
                if(res.title) $('#title').val(res.title);
                $('#importModal').modal('hide');
                spawnAlert('success', 'Context Imported');
            }
        },
        error: () => spawnAlert('danger', 'Import failed.')
    });
}

function submitBlog() {
    const payload = {
        title: $('#title').val(),
        maintag: $('#maintag').val(),
        content: quillObj.root.innerHTML,
        types: [$('#maintag').val()],
        categories: $('#categories').val() ? $('#categories').val().map(Number) : [],
        subcats: $('#subcats').val() ? $('#subcats').val().map(Number) : [],
        tags: $('#tags').val() ? $('#tags').val().split(',').map(s => s.trim()) : [],
        public: true,
        archived: false
    };

    if(!payload.title || quillObj.getText().trim().length < 2) {
        spawnAlert('danger', 'Report Title and Content are required.');
        return;
    }

    $.ajax({
        url: 'https://127.0.0.1:5001/api/report/createblog',
        method: 'POST',
        contentType: 'application/json',
        xhrFields: { withCredentials: true },
        data: JSON.stringify(payload),
        success: () => window.location.href = "/listreports",
        error: (x) => spawnAlert('danger', 'Error: ' + x.responseText)
    });
}

function createMetadata(url, data) {
    $.ajax({
        url: url, method: 'POST', contentType: 'application/json',
        xhrFields: { withCredentials: true },
        data: JSON.stringify(data),
        success: () => location.reload()
    });
}

function spawnAlert(type, msg) {
    $('#ms-alert-stack').html(`<div class="alert alert-${type} shadow">${msg}</div>`);
    setTimeout(() => $('#ms-alert-stack').empty(), 5000);
}
</script>