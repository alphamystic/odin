          <div class="timeline">
            <div class="pb-3 timeline-item item-primary">
              <div class="pl-5">
                <div class="mb-1"><strong>Step 1: Payload Generation</strong></div>
                <p class="small text-muted">Generate a base64 encoded reverse shell payload for Linux environments.</p>
              </div>
            </div>
            <div class="pb-3 timeline-item item-warning">
              <div class="pl-5">
                <div class="mb-1"><strong>Step 2: Injection Vector</strong></div>
                <p class="small text-muted">Submit the payload via the <code>X-Internal-Header</code> parameter.</p>
                <div class="card d-inline-flex mb-2 w-100 bg-dark">
                  <div class="card-body py-2 px-3">
                    <code class="text-success">curl -H "X-Internal-Header: $(PAYLOAD)" http://internal.target/api/sync</code>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
