        </div>
        <div class="card-body">
          <table class="table table-borderless table-striped">
            <thead>
              <tr>
                <th>CVE / ID</th>
                <th>Category</th>
                <th>Affected Service</th>
                <th class="text-right">Complexity</th>
                <th class="text-right">Exposure</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>CVE-2026-X123</strong></td>
                <td>Injection</td>
                <td><span class="text-muted">Auth-Middleware</span></td>
                <td class="text-right text-success">Low</td>
